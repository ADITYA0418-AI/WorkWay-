# ====================================================================
# WORKWAY V2 ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in your values
# ====================================================================

# --------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite Client)
# Note: Variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secret keys, database passwords, or private API keys here!
# --------------------------------------------------------------------

# Supabase Project Credentials (Found in Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Demo Mode (Set to "false" to use live Supabase database; "true" to force offline mock data)
VITE_ENABLE_DEMO_MODE=true

# Razorpay Key ID (Public test/live key for Checkout modal, e.g. rzp_test_...)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Mapbox Access Token (Optional - standard OpenStreetMap/Leaflet active by default)
VITE_MAPBOX_TOKEN=

# Google Analytics 4 Measurement ID (Optional, consent-guarded, e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# --------------------------------------------------------------------
# 2. BACKEND PRIVATE CONFIGURATION (Server Side Only)
# Note: These variables are NEVER exposed to the frontend/browser.
# --------------------------------------------------------------------

PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/workway
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Google Gemini API Key for Server-Side AI Job Problem Diagnosis
GEMINI_API_KEY=your-gemini-api-key-here

# Razorpay Secret Key for Server-Side Payment Verification (HMAC-SHA256)
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
